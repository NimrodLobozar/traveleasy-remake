# Production web server (ADR-0002 D1): FrankenPHP in classic mode (no worker mode, no Octane).
# TLS ends at Nginx Proxy Manager, so this listens on plain HTTP :8080 inside the container network.
{
	auto_https off
	admin off
	skip_install_trust

	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:4}
	}
}

:8080 {
	root * /var/www/html/public
	encode zstd br gzip

	# No uploads in v1 (ADR-0002 D1).
	request_body {
		max_size 2MB
	}

	# No access log on purpose: IP address + URL are personal data. The app logs what it needs itself.

	# Security headers for everything the web server answers by itself (static files, which the Laravel
	# middleware never sees; TE-012 AC16) and for any PHP failure that produced no headers. The `?` prefix
	# means "only if the response has no such header yet", so the per-request nonce CSP that the app sets
	# (AddSecurityHeaders, TE-015) always wins. A static file needs no scripts, styles or frames at all.
	header {
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# Vite output is content-hashed, so it can be cached for a year.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Hidden files and folders are never served (.htaccess, .env, .git, ...), except /.well-known/ (TE-028).
	@hidden {
		path /.*
		not path /.well-known/*
	}
	handle @hidden {
		respond 404
	}

	handle {
		php_server
	}
}
