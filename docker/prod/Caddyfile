# Production web server (ADR-0002 D1): FrankenPHP in classic mode (no worker mode, no Octane).
# TLS ends at Nginx Proxy Manager, so this listens on plain HTTP :8080 inside the container network.
{
	auto_https off
	admin off
	skip_install_trust

	frankenphp {
		num_threads {$FRANKENPHP_NUM_THREADS:4}
	}
}

:8080 {
	root * /var/www/html/public
	encode zstd br gzip

	# No uploads in v1 (ADR-0002 D1).
	request_body {
		max_size 2MB
	}

	# No access log on purpose: IP address + URL are personal data. The app logs what it needs itself.

	# Security headers for everything the web server answers by itself (static files, which the Laravel
	# middleware never sees; TE-012 AC16) and for any PHP failure that produced no headers. The `?` prefix
	# means "only if the response has no such header yet", so the per-request nonce CSP that the app sets
	# (AddSecurityHeaders, TE-015) always wins. A static file needs no scripts, styles or frames at all.
	header {
		?Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		?X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		?Referrer-Policy "strict-origin-when-cross-origin"
		-Server
		-X-Powered-By
	}

	# Vite output is content-hashed, so it can be cached for a year.
	@build path /build/*
	header @build Cache-Control "public, max-age=31536000, immutable"

	# Hidden files and folders are never served (.htaccess, .env, .git, ...), except /.well-known/ (TE-028).
	@hidden {
		path /.*
		not path /.well-known/*
	}
	handle @hidden {
		respond 404
	}

	handle {
		php_server
	}

	# TE-019 AC9: when PHP or the upstream is unreachable (502/504) the app cannot render its own error page, so the
	# web server answers with a static, bilingual (nl/en) page. No script, no style, no external resource, so the strict
	# CSP below needs no nonce. Headers set by `header` above do not apply to error routes, so they are repeated here.
	# Other error statuses keep Caddy's default (empty body).
	handle_errors {
		@unavailable expression {http.error.status_code} in [502, 504]
		handle @unavailable {
			header {
				Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
				X-Content-Type-Options "nosniff"
				X-Frame-Options "DENY"
				Referrer-Policy "strict-origin-when-cross-origin"
				Cache-Control "no-store"
				Content-Type "text/html; charset=utf-8"
				-Server
			}
			respond <<HTML
				<!doctype html>
				<html lang="nl">
				<head>
				<meta charset="utf-8">
				<meta name="viewport" content="width=device-width, initial-scale=1">
				<meta name="color-scheme" content="light dark">
				<title>TravelEasy is tijdelijk niet bereikbaar / temporarily unavailable</title>
				</head>
				<body>
				<main>
				<h1>TravelEasy is tijdelijk niet bereikbaar</h1>
				<p>Er ging iets mis aan onze kant. Probeer het over een paar minuten opnieuw.</p>
				<h1 lang="en">TravelEasy is temporarily unavailable</h1>
				<p lang="en">Something went wrong on our side. Please try again in a few minutes.</p>
				</main>
				</body>
				</html>
				HTML {http.error.status_code}
		}
	}
}
