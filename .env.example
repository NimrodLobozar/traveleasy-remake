# TravelEasy environment template. Copy to `.env` (git-ignored) and fill in the blanks.
# Never put real secrets in this file. The app sends no e-mail (ADR-0005), so there are no MAIL_* variables.
# Docker dev setup: only DB_PASSWORD must be filled in; APP_KEY is generated on the first `docker compose up`.

# --- Docker Compose (development) -------------------------------------------------------------------
# Compose project name comes from compose.yaml (`traveleasy-remake`).
# Which compose files plain `docker compose` loads: the base file plus the dev overrides.
COMPOSE_FILE=compose.yaml:compose.dev.yaml
# Separator used in COMPOSE_FILE. Set explicitly so the same value works in PowerShell, cmd and Git Bash.
COMPOSE_PATH_SEPARATOR=:
# Optional tools profile. Leave commented: Adminer then only starts with `docker compose --profile tools up -d`.
# COMPOSE_PROFILES=tools
# Host port for the app (published on 127.0.0.1 only). Keep APP_URL in sync.
APP_PORT=8000
# Port of the Vite dev server, inside the container and on 127.0.0.1 of the host.
VITE_PORT=5173
# Poll for file changes. Needed on Windows bind mounts (NTFS); set false if the repo lives in the WSL file system.
VITE_USE_POLLING=true
# Polling interval in milliseconds (higher = less idle CPU, slower HMR).
VITE_POLLING_INTERVAL=1000
# (VITE_HOST is set by compose.dev.yaml to 0.0.0.0 inside the container; don't set it here.)
# Host port for Adminer (tools profile, 127.0.0.1 only).
ADMINER_PORT=8081
# Run pending migrations when the app container starts (never seeds).
MIGRATE_ON_START=true
# Number of PHP workers behind `php artisan serve` in the app container.
PHP_CLI_SERVER_WORKERS=4

# Application name, shown in the UI and page titles.
APP_NAME=TravelEasy
# Environment: local (development), testing or production.
APP_ENV=local
# Encryption key. Must stay empty here: the app container generates it into `.env` on first start
# (or run `docker compose exec app php artisan key:generate`). An existing key is never overwritten.
APP_KEY=
# Show detailed error pages. Dev default only: production MUST set APP_DEBUG=false.
APP_DEBUG=true
# Public base URL of the app, used for generated links.
APP_URL=http://localhost:8000

# Default UI locale (Dutch; English is the fallback).
APP_LOCALE=nl
# Locale used when a translation is missing.
APP_FALLBACK_LOCALE=en
# Locale for fake data in factories and the demo seeder.
APP_FAKER_LOCALE=en_US

# Where maintenance-mode state is stored (file or cache).
APP_MAINTENANCE_DRIVER=file

# Bcrypt cost factor for password hashing.
BCRYPT_ROUNDS=12

# Log channel to use (stack combines the channels in LOG_STACK).
LOG_CHANNEL=stack
# Channels used by the stack channel, comma-separated.
LOG_STACK=single
# Channel for PHP/framework deprecation warnings (null = discard).
LOG_DEPRECATIONS_CHANNEL=null
# Minimum level that gets logged (debug in dev; use warning or higher in production).
LOG_LEVEL=debug

# Database driver; TravelEasy runs on PostgreSQL only.
DB_CONNECTION=pgsql
# Database host (the compose service name).
DB_HOST=db
# Database port.
DB_PORT=5432
# Database name.
DB_DATABASE=traveleasy
# Database user.
DB_USERNAME=traveleasy
# Database password (REQUIRED). Must stay empty here; set a strong one in `.env`, e.g. the output of
# `openssl rand -hex 24` (Git Bash). `docker compose` refuses to start without it. Used by the db service on its first
# start; changing it later needs `ALTER USER` in the database as well.
DB_PASSWORD=

# Where sessions are stored.
SESSION_DRIVER=database
# Session lifetime in minutes.
SESSION_LIFETIME=120
# Encrypt session payloads at rest.
SESSION_ENCRYPT=false
# Send the session cookie over HTTPS only. Production behind Nginx Proxy Manager: true (needs an https APP_URL
# and TRUSTED_PROXIES). Leave unset for plain-HTTP dev and for a LAN-only HTTP check (docs/deploy/production-image.md).
# SESSION_SECURE_COOKIE=true
# Cookie path for the session cookie.
SESSION_PATH=/
# Cookie domain for the session cookie (null = current host only).
SESSION_DOMAIN=null

# Broadcasting driver (log = no real-time broadcasting).
BROADCAST_CONNECTION=log
# Default filesystem disk for uploads.
FILESYSTEM_DISK=local
# Queue backend for background jobs.
QUEUE_CONNECTION=database

# Cache backend.
CACHE_STORE=database

# --- Inertia server-side rendering (TE-007) -----------------------------------------------------------
# Render the first page visit on the server (Node SSR process, `php artisan inertia:start-ssr`). If the SSR
# process is down or slow, pages are rendered client-side instead (same HTTP 200). Skipped while the Vite dev
# server runs (public/hot exists): dev stays client-side with HMR.
INERTIA_SSR_ENABLED=true
# Where the app reaches the SSR server. In Docker: the compose-internal service, e.g. http://ssr:13714 (TE-008).
# Defaults to http://127.0.0.1:${INERTIA_SSR_PORT}.
INERTIA_SSR_URL=http://127.0.0.1:13714
# Seconds one SSR render may take (connect included) before the page falls back to client-side rendering.
INERTIA_SSR_TIMEOUT=2
# Address and port the Node SSR server listens on (read by resources/js/ssr.tsx). Keep the loopback address unless
# the server runs in its own container; then use 0.0.0.0 on the compose-internal network only. Never publish this
# port on the host: the SSR server has no authentication.
INERTIA_SSR_HOST=127.0.0.1
# Port of the Node SSR server (keep INERTIA_SSR_URL in sync).
INERTIA_SSR_PORT=13714

# --- Production image (TE-012, docs/deploy/production-image.md) --------------------------------------------------
# Inertia devtools (dev-only routes under /_inertia/devtools). The production image sets this to false; never enable
# it on a reachable server. Unset in dev = the framework default (on when APP_ENV=local).
# INERTIA_DEVTOOLS_ENABLED=false
# Proxies whose X-Forwarded-For/-Proto/-Port are trusted: the CIDR of the Docker network Nginx Proxy Manager uses
# (`docker network inspect npm_shared`), or NPM's single IP, comma-separated. Empty = trust no proxy. `*`, `**`,
# `REMOTE_ADDR` and /0 ranges are rejected: the production boot check refuses to start (TE-012 AC12).
TRUSTED_PROXIES=
# Seconds the production `app` entrypoint waits for the database before it exits non-zero.
DB_WAIT_TIMEOUT=60
# Worker threads of the FrankenPHP web server (production image; 4 is sized for the small office PC).
FRANKENPHP_NUM_THREADS=4
# Secret for deriving WebAuthn user handles. UNUSED until M1 decides how passkeys identify users; leave empty.
# PASSKEYS_USER_HANDLE_SECRET=

# --- Security headers (TE-015, docs/deploy/security-headers.md) ------------------------------------------------
# HSTS is sent only when APP_URL starts with https://. Seconds browsers stay HTTPS-only (default 180 days).
HSTS_MAX_AGE=15552000
# Add `includeSubDomains` / `preload` only when every subdomain is HTTPS-only for good; preload is hard to undo.
HSTS_INCLUDE_SUBDOMAINS=false
# Add `preload` (only after a deliberate hstspreload.org submission).
HSTS_PRELOAD=false
# Optional same-origin path for CSP violation reports, e.g. /csp-report. Empty = no reporting (default). URLs to
# other hosts are ignored: reports never leave the site.
CSP_REPORT_PATH=

# App name exposed to the frontend bundle by Vite.
VITE_APP_NAME="${APP_NAME}"
