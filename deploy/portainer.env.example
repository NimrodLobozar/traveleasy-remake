# TravelEasy production variables for the Portainer stack (compose.yaml). Plain KEY=value lines.
# TE-024 ships the variables the compose file reads; TE-025 adds the secrets helper and finishes this file.
# Lines marked "SECRET" stay empty here: generate them (docs/deploy/casaos-portainer.md) and paste them in Portainer.
# Never commit real values.

# --- Image ---
# Released image tag, never "latest". PLACEHOLDER until the first release is published (TE-014).
APP_IMAGE_TAG=v0.1.0

# --- Application ---
APP_NAME=TravelEasy
# EDIT: the public https URL that Nginx Proxy Manager serves.
APP_URL=https://traveleasy.example.com
APP_LOCALE=nl
LOG_LEVEL=warning
# true behind Nginx Proxy Manager with an https APP_URL.
SESSION_SECURE_COOKIE=true
# EDIT (TE-026): the CIDR of the npm_shared network, from `docker network inspect npm_shared`. Never * and never /0.
TRUSTED_PROXIES=
FRANKENPHP_NUM_THREADS=4
DB_WAIT_TIMEOUT=60
INERTIA_SSR_ENABLED=true
INERTIA_SSR_URL=http://ssr:13714
INERTIA_SSR_TIMEOUT=2
HSTS_MAX_AGE=15552000
HSTS_INCLUDE_SUBDOMAINS=false
HSTS_PRELOAD=false
CSP_REPORT_PATH=

# --- Database ---
DB_DATABASE=traveleasy
# The restricted application role (created by the db-init service).
DB_USERNAME=traveleasy_app
# SECRET: generate with the secrets helper. Superuser password, used only by db and db-init.
DB_SUPERUSER_PASSWORD=
# SECRET: generate with the secrets helper. Password of the application role.
DB_PASSWORD=
# SECRET: generate with the secrets helper (base64:...). Laravel encryption key.
APP_KEY=

# --- Resource limits (memory, CPUs, process count) ---
APP_MEM_LIMIT=768m
APP_CPUS=2.0
APP_PIDS_LIMIT=256
SSR_MEM_LIMIT=256m
SSR_CPUS=1.0
SSR_PIDS_LIMIT=100
POSTGRES_MEM_LIMIT=1g
POSTGRES_CPUS=2.0
POSTGRES_PIDS_LIMIT=200
DBINIT_MEM_LIMIT=128m
DBINIT_CPUS=0.5
DBINIT_PIDS_LIMIT=64
