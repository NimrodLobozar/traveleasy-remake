# TravelEasy production variables for the Portainer stack (compose.yaml). Plain KEY=value lines.
# Every variable compose.yaml reads, with a working default; only the marked values need you (a test keeps both in sync).
# Lines marked "SECRET" stay empty here: generate them with the command in docs/deploy/casaos-portainer.md and paste them in Portainer.
# Never commit real values.

# --- Image ---
# Released image tag, never "latest". PLACEHOLDER until the first release is published (TE-014).
APP_IMAGE_TAG=v0.1.0

# --- Application ---
APP_NAME=TravelEasy
# EDIT: the public https URL that Nginx Proxy Manager serves.
APP_URL=https://traveleasy.example.com
# Default interface language (nl or en).
APP_LOCALE=nl
# Laravel log level; warning keeps logs small and free of request detail.
LOG_LEVEL=warning
# true behind Nginx Proxy Manager with an https APP_URL.
SESSION_SECURE_COOKIE=true
# EDIT (owner value): the single FIXED IP of Nginx Proxy Manager on npm_shared (docs/deploy/casaos-portainer.md). Never the
# network CIDR, never * (the app refuses to start).
TRUSTED_PROXIES=
# OPTIONAL (owner value): login e-mail of the super_admin account; the account eraser refuses to erase it. Empty = none.
SUPER_ADMIN_EMAIL=
# PHP worker threads of the app container; 4 fits the memory limit.
FRANKENPHP_NUM_THREADS=4
# Seconds the app waits for the database before it gives up.
DB_WAIT_TIMEOUT=60
# Server-side rendering on; the site falls back to client rendering if ssr is down.
INERTIA_SSR_ENABLED=true
# Internal address of the ssr service; keep as is.
INERTIA_SSR_URL=http://ssr:13714
# Seconds to wait for a server-rendered page before falling back.
INERTIA_SSR_TIMEOUT=2
# HSTS lifetime in seconds (180 days); only sent over https.
HSTS_MAX_AGE=15552000
# Keep false unless every subdomain serves https.
HSTS_INCLUDE_SUBDOMAINS=false
# Keep false: preload is practically irreversible.
HSTS_PRELOAD=false
# Empty = no CSP violation reporting endpoint; set a local path only if you build one.
CSP_REPORT_PATH=

# --- Database ---
DB_DATABASE=traveleasy
# The restricted application role (created by the db-init service).
DB_USERNAME=traveleasy_app
# SECRET: generate with traveleasy:generate-secrets (docs/deploy/casaos-portainer.md). Superuser password, used only by db and db-init.
DB_SUPERUSER_PASSWORD=
# SECRET: generate with traveleasy:generate-secrets (docs/deploy/casaos-portainer.md). Password of the application role.
DB_PASSWORD=
# SECRET: generate with traveleasy:generate-secrets (docs/deploy/casaos-portainer.md). Format base64:... Laravel encryption key.
APP_KEY=

# --- Resource limits (memory, CPUs, process count) ---
APP_MEM_LIMIT=768m
# CPU limit of the app container.
APP_CPUS=2.0
# Process limit of the app container.
APP_PIDS_LIMIT=256
# Memory limit of the ssr container.
SSR_MEM_LIMIT=256m
# CPU limit of the ssr container.
SSR_CPUS=1.0
# Process limit of the ssr container.
SSR_PIDS_LIMIT=100
# Memory limit of the db container.
POSTGRES_MEM_LIMIT=1g
# CPU limit of the db container.
POSTGRES_CPUS=2.0
# Process limit of the db container.
POSTGRES_PIDS_LIMIT=200
# Memory limit of the one-shot db-init container.
DBINIT_MEM_LIMIT=128m
# CPU limit of the db-init container.
DBINIT_CPUS=0.5
# Process limit of the db-init container.
DBINIT_PIDS_LIMIT=64
