{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "nimrodlobozar/traveleasy-remake",
    "type": "project",
    "description": "TravelEasy: travel-agency web app (remake).",
    "keywords": [
        "laravel",
        "framework"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "inertiajs/inertia-laravel": "^3.0",
        "laravel/fortify": "^1.37.2",
        "laravel/framework": "^13.17",
        "laravel/tinker": "^3.0",
        "laravel/wayfinder": "^0.1.14",
        "spatie/laravel-data": "^4.23",
        "spatie/laravel-typescript-transformer": "^3.3"
    },
    "require-dev": {
        "brianium/paratest": "7.26.0",
        "fakerphp/faker": "^1.24",
        "larastan/larastan": "^3.9",
        "laravel/pail": "^1.2.5",
        "laravel/pao": "^1.0.6",
        "laravel/pint": "^1.27",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.9.3",
        "pestphp/pest": "^5.3",
        "pestphp/pest-plugin-laravel": "^5.0",
        "pestphp/pest-plugin-phpstan": "^5.2.2",
        "symfony/yaml": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "composer install",
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\"",
            "@php artisan key:generate",
            "@php artisan migrate --force",
            "npm install",
            "npm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan dev"
        ],
        "lint": [
            "pint --test",
            "pint --test --config=pint.no-strict-types.json bootstrap config public"
        ],
        "format": [
            "pint",
            "pint --config=pint.no-strict-types.json bootstrap config public"
        ],
        "analyse": [
            "Composer\\Config::disableProcessTimeout",
            "phpstan analyse --memory-limit=1G --no-progress"
        ],
        "test": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test"
        ],
        "test:parallel": [
            "Composer\\Config::disableProcessTimeout",
            "@php artisan test --parallel"
        ],
        "check": [
            "Composer\\Config::disableProcessTimeout",
            "@lint",
            "@analyse",
            "@test"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "scripts-descriptions": {
        "lint": "Check PHP code style with Pint (no changes).",
        "format": "Fix PHP code style with Pint.",
        "analyse": "Run Larastan (PHPStan, level max) on app, bootstrap/app.php, config, database, routes and tests.",
        "test": "Run the Pest test suite against traveleasy_test.",
        "test:parallel": "Run the Pest test suite in parallel (one traveleasy_test_test_N database per worker).",
        "check": "Run lint, analyse and test in sequence; stops at the first failure."
    },
    "extra": {
        "laravel": {
            "dont-discover": [],
            "installer": {
                "post-create-project": [
                ]
            }
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
