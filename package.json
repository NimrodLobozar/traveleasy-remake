{
    "$schema": "https://www.schemastore.org/package.json",
    "name": "traveleasy-remake",
    "private": true,
    "license": "MIT",
    "type": "module",
    "scripts": {
        "build": "vp build && vp build --ssr",
        "dev": "vp dev",
        "generate": "php artisan wayfinder:generate --with-form && php artisan typescript:transform",
        "lint": "vp lint",
        "lint:fix": "vp lint --fix",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "types": "npm run generate && npm run types:check",
        "types:check": "tsc --noEmit && tsc --noEmit -p tests/e2e",
        "test": "vp test run",
        "test:watch": "vp test watch",
        "test:e2e": "playwright test --config tests/e2e/playwright.config.ts",
        "test:ssr": "node scripts/ssr-smoke.mjs --mode on",
        "test:ssr:down": "node scripts/ssr-smoke.mjs --mode down",
        "i18n:check": "node scripts/i18n-check.ts",
        "check": "npm run generate && npm run lint && npm run format:check && npm run types:check && npm run i18n:check",
        "check:fix": "npm run generate && vp check --fix"
    },
    "dependencies": {
        "@inertiajs/react": "^3.10.0",
        "@inertiajs/vite": "^3.10.0",
        "@internationalized/date": "^3.12.4",
        "@laravel/passkeys": "^0.4.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.11",
        "@radix-ui/react-avatar": "^1.3.1",
        "@radix-ui/react-checkbox": "^1.4.1",
        "@radix-ui/react-collapsible": "^1.2.1",
        "@radix-ui/react-dialog": "^1.3.1",
        "@radix-ui/react-dropdown-menu": "^2.2.1",
        "@radix-ui/react-label": "^2.1.17",
        "@radix-ui/react-navigation-menu": "^1.4.1",
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-separator": "^1.2.0",
        "@radix-ui/react-slot": "^1.5.0",
        "@radix-ui/react-toggle": "^1.2.1",
        "@radix-ui/react-toggle-group": "^1.2.1",
        "@radix-ui/react-tooltip": "^1.4.1",
        "@tailwindcss/vite": "^4.1.11",
        "@types/react": "^19.2.0",
        "@types/react-dom": "^19.2.0",
        "@vitejs/plugin-react": "^6.1.1",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "concurrently": "^10.0.3",
        "input-otp": "^1.4.2",
        "laravel-vite-plugin": "^3.0.0",
        "lucide-react": "^1.66.0",
        "react": "^19.3.1",
        "react-aria": "^3.53.1",
        "react-aria-components": "^1.22.1",
        "react-dom": "^19.3.1",
        "sonner": "^2.0.0",
        "tailwind-merge": "^3.0.1",
        "tailwindcss": "^4.0.0",
        "tw-animate-css": "^1.4.0",
        "typescript": "^7.0.2",
        "vite": "npm:@voidzero-dev/vite-plus-core@0.3.3"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.14.0",
        "@playwright/test": "1.64.0",
        "@rolldown/plugin-babel": "^0.3.0",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "axe-core": "~4.14.0",
        "babel-plugin-react-compiler": "^1.0.0",
        "jsdom": "^30.1.3",
        "vite-plus": "1.4.0"
    },
    "optionalDependencies": {
        "@laravel/multiplex": "^0.4.1",
        "@rollup/rollup-linux-x64-gnu": "4.67.2",
        "@rollup/rollup-win32-x64-msvc": "4.67.2",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    },
    "overrides": {
        "vite": "$vite"
    },
    "//": [
        "Vite advisory gap (TE-003 AC13): `dependencies.vite` is an npm alias for @voidzero-dev/vite-plus-core (pinned with vite-plus), so `npm audit` can't see Vite security advisories.",
        "Manual check on every dependency update: read the vite-plus / vite-plus-core release notes and the Vite security advisories (https://github.com/vitejs/vite/security/advisories) for the bundled Vite version (`npx vp --version`).",
        "Move to vite-plus 1.x with a plain `vite` dependency when the Laravel React starter kit does; then remove this note."
    ]
}
